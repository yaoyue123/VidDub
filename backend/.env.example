# SiliconFlow API Credentials
# Only required when translation_backend=siliconflow or tts_backend=siliconflow.
# Get your key at: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# SiliconFlow Base URL (optional, only change for proxy/self-hosted)
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Whisper (local STT) — model size: tiny/base/small/medium
WHISPER_MODEL=small
WHISPER_LANGUAGE=en

# Storage
DOWNLOADS_DIR=./downloads
DATABASE_URL=sqlite+aiosqlite:///./data/viddub.db

# Free/local mode (configure in the Web UI or /api/config):
#   translation_backend=google
#   tts_backend=moss          # local MOSS-TTS-Nano, see scripts/install_moss_tts.ps1
#   tts_backend=edge-tts      # free online, blocked on some networks

# Network (optional). yt-dlp honors yt_dlp_proxy from the config table first;
# otherwise these environment variables are used.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# YTDLP_PROXY=http://127.0.0.1:7890
